# Copy to .env and fill in real values. Never commit the real .env file.

# --- Hugging Face (FineWeb-Edu streaming, tokenizer/dataset downloads) ---
HF_TOKEN=

# --- Cloudflare R2 (DVC remote; bucket entropic-substrate-lm) ---
# AWS_* hold the S3-protocol credentials from an R2 API token scoped to
# Object Read & Write on the bucket — AWS_* is what DVC/boto3/s3fs read,
# and R2 is S3-wire-compatible. R2_API_KEY is the Cloudflare API token
# itself (account management, not object I/O).
R2_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- RunPod ---
RUNPOD_API_KEY=

# --- Experiment tracking / misc ---
WANDB_API_KEY=

# --- Device / run overrides ---
ENTROPIC_SUBSTRATE_DEVICE=cuda
