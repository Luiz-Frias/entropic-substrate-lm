# Copy to .env and fill in real values. Never commit the real .env file.

# --- Hugging Face (FineWeb-Edu streaming, tokenizer/dataset downloads) ---
HF_TOKEN=

# --- DVC remote credentials (Cloudflare R2; remote itself is committed in .dvc/config) ---
# Use an R2 API token scoped to Object Read & Write on the entropic-substrate-lm bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Experiment tracking / misc ---
WANDB_API_KEY=

# --- Device / run overrides ---
ENTROPIC_SUBSTRATE_DEVICE=cuda
