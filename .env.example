# Copy to .env and fill in real values. Never commit the real .env file.

# --- Hugging Face (FineWeb-Edu streaming, tokenizer/dataset downloads) ---
HF_TOKEN=

# --- Cloudflare R2 (DVC remote; bucket entropic-substrate-lm) ---
# AWS_* hold the S3-protocol credentials from an R2 API token scoped to
# Object Read & Write on the bucket — AWS_* is what DVC/boto3/s3fs read,
# and R2 is S3-wire-compatible. R2_API_KEY is the Cloudflare API token
# itself (account management, not object I/O).
R2_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- RunPod ---
RUNPOD_API_KEY=

# --- Experiment tracking / misc ---
WANDB_API_KEY=

# MLflow — analysis/citation surface for run metrics (entropic_substrate.sinks).
# Unset = untracked (JSONL-only). Set to a real server to track non-tiny runs;
# --tiny additionally requires ENTROPIC_MLFLOW_TINY=1 (CPU smoke runs stay
# untracked by default). `just container-test` runs a local instance,
# backed by Postgres and this repo's real R2 bucket, at an EPHEMERAL host
# port podman assigns — scripts/run_container_test.sh discovers it and sets
# MLFLOW_TRACKING_URI itself; no fixed port to hardcode here.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=entropic-substrate-lm
# Only read by compose.yaml (the local MLflow server's artifact proxy talks
# S3-protocol to R2, same endpoint as the DVC remote in .dvc/config).
MLFLOW_S3_ENDPOINT_URL=https://62c7fd87a1874f1dee6b149ad40ac657.r2.cloudflarestorage.com
# Only read by compose.yaml (mlflow's DNS-rebinding host allowlist / CORS
# guard, p3). DO NOT set either of these here for local `just
# container-test` convenience — compose.yaml's --allowed-hosts REPLACES
# mlflow's compiled-in localhost default outright rather than extending it
# (verified empirically against the pinned image), so a Railway-domain
# value here would silently 403 every local integration test the moment
# it's sourced. Leave both unset locally; the deploy environment (e.g.
# Railway) supplies its own domain(s) at deploy time. Comma-separated host
# list / origin list per MLflow 3.15's --allowed-hosts /
# --cors-allowed-origins CLI flags. NEVER '*' — that disables the guard
# entirely (see compose.yaml).
MLFLOW_ALLOWED_HOSTS=
MLFLOW_CORS_ALLOWED_ORIGINS=

# --- Device / run overrides ---
ENTROPIC_SUBSTRATE_DEVICE=cuda
