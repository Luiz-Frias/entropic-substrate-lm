# Copy to .env and fill in real values. Never commit the real .env file.

# --- Hugging Face (FineWeb-Edu streaming, tokenizer/dataset downloads) ---
HF_TOKEN=

# --- Cloudflare R2 (DVC remote; bucket entropic-substrate-lm) ---
# AWS_* hold the S3-protocol credentials from an R2 API token scoped to
# Object Read & Write on the bucket — AWS_* is what DVC/boto3/s3fs read,
# and R2 is S3-wire-compatible. R2_API_KEY is the Cloudflare API token
# itself (account management, not object I/O).
R2_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- RunPod ---
RUNPOD_API_KEY=

# --- Experiment tracking / misc ---
WANDB_API_KEY=

# MLflow — analysis/citation surface for run metrics (entropic_substrate.sinks).
# Unset = untracked (JSONL-only). Set to a real server to track non-tiny runs;
# --tiny additionally requires ENTROPIC_MLFLOW_TINY=1 (CPU smoke runs stay
# untracked by default). `just container-test` runs a local instance,
# backed by Postgres and this repo's real R2 bucket, at an EPHEMERAL host
# port podman assigns — scripts/run_container_test.sh discovers it and sets
# MLFLOW_TRACKING_URI itself; no fixed port to hardcode here.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=entropic-substrate-lm
# CLIENT-SIDE credentials for a tracking server behind the Caddy basic-auth
# proxy below. Read natively by the pinned mlflow-skinny client (its own
# credentials.py looks up exactly these two names) — sinks.py needs no code to
# use them. Documented here because the CADDY_* block below configures the
# SERVER side only: an operator who set up the proxy from that block alone
# would have a locked door and no key, and the training pod would be unable to
# reach the tracker at all. Leave both unset locally for the same reason the
# CADDY_* pair is unset — `just container-test`'s phase 3 generates a fresh
# credential pair per run and passes it as subprocess environment.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Only read by compose.yaml (the local MLflow server's artifact proxy talks
# S3-protocol to R2, same endpoint as the DVC remote in .dvc/config).
MLFLOW_S3_ENDPOINT_URL=https://62c7fd87a1874f1dee6b149ad40ac657.r2.cloudflarestorage.com
# Only read by compose.yaml (mlflow's DNS-rebinding host allowlist / CORS
# guard, p3). DO NOT set either of these here for local `just
# container-test` convenience — a set allowlist REPLACES mlflow's
# compiled-in localhost default outright rather than extending it (verified
# empirically against the pinned image), so a Railway-domain value here
# would silently 403 every local integration test the moment it's sourced.
# Leave both unset locally; the deploy environment (e.g. Railway) supplies
# its own domain(s) at deploy time. Comma-separated host list / origin list.
# NEVER '*' — that disables the guard entirely (see compose.yaml).
#
# These ARE mlflow's own operator-facing names, forwarded straight through:
# compose.yaml declares them under services.mlflow.environment as MLflow's
# NATIVE MLFLOW_SERVER_ALLOWED_HOSTS / MLFLOW_SERVER_CORS_ALLOWED_ORIGINS
# (click `envvar=`, mlflow/utils/cli_args.py:256,270 in the pinned image) —
# no CLI flag, no shell, no separate compose-local name to keep in sync.
# CORRECTION (2026-08-14, p4): an earlier revision of this comment described
# a CLI-flag-forwarding indirection ("these names are COMPOSE-LOCAL... it
# does not forward them under the MLFLOW_SERVER_* names too") as a possible
# future follow-up. That follow-up already happened (refactor/mlflow-
# allowlist-env-native) — compose.yaml has declared the native
# MLFLOW_SERVER_* names directly since then, and the stale text above
# described a mechanism that no longer exists.
MLFLOW_ALLOWED_HOSTS=
MLFLOW_CORS_ALLOWED_ORIGINS=

# Caddy reverse proxy (p4) — the ONLY authentication in front of the local
# MLflow stack; see Caddyfile and compose.yaml's `caddy` service. Gated
# behind the `proxy` compose profile, so these are read ONLY when that
# profile is explicitly requested (`just container-test`'s phase 3,
# tests/test_caddy_auth.py) — a plain `just container-test` never touches
# them. Leave both unset locally: the live-gate fixture generates a fresh
# username/password (and hashes the password with the pinned caddy image's
# own `caddy hash-password`) per run and passes them directly as subprocess
# environment, never through this file. NEVER commit a real value here —
# CADDY_BASIC_AUTH_HASH is a bcrypt hash, and a hash is still a credential
# (NO CREDENTIALS COMMITTED, hashed or otherwise).
CADDY_BASIC_AUTH_USER=
CADDY_BASIC_AUTH_HASH=

# --- Device / run overrides ---
ENTROPIC_SUBSTRATE_DEVICE=cuda
