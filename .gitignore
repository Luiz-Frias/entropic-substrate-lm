# =============================================================================
# entropic-substrate-lm — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Caches ---
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.basedpyright_cache/
.hypothesis/
.benchmarks/

# --- Coverage ---
.coverage
.coverage.*
htmlcov/

# --- Data / model / results artifacts ---
# These directories are DVC/large-artifact working dirs. Keep the directory
# placeholders (.gitkeep) but ignore everything else committed inside them —
# actual data is tracked via `dvc add`, not git. The tiny *.dvc pointer files
# produced by `dvc add` ARE git's half of that contract and must not be ignored.
data/*
!data/.gitkeep
!data/*.dvc
models/*
!models/.gitkeep
!models/*.dvc
results/*
!results/.gitkeep
!results/*.dvc

# --- Jupyter / notebooks scratch ---
# marimo notebooks are plain, reviewable .py source (no cell-output blobs to
# scrub), unlike .ipynb — tracked deliberately, unlike the scratch directory
# default below. Git does not descend into an ignored DIRECTORY, so the
# subdirectory re-include (`!notebooks/**/`) must come BEFORE the .py
# re-include — without it a nested notebook (notebooks/e4/charts.py) stays
# invisible to git entirely. MEASURED with `git check-ignore -v`: pre-fix
# notebooks/e4/charts.py matched `notebooks/*`; post-fix it is unignored
# while notebooks/e4/scratch.txt still matches `notebooks/**`.
notebooks/**
!notebooks/.gitkeep
!notebooks/**/
!notebooks/**/*.py
.ipynb_checkpoints/

# --- Logs ---
logs/
*.log

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# NOTE: .dvc/config is intentionally NOT ignored — DVC remote/config metadata
# is tracked in git. Only DVC's own internal cache/tmp dirs are excluded (see
# .dvc/.gitignore, managed by `dvc init`).

# --- Worktrees ---
.claude/worktrees/
.codex/worktrees/

# --- Local Files ---
# `*.local` matches justfile.local but NOT CLAUDE.local.md — the pattern needs
# the name to END in `.local`, so anything carrying a real extension after it
# (CLAUDE.local.md, notes.local.md) fell through. Verified with
# `git check-ignore -v`: justfile.local matched, CLAUDE.local.md did not.
*.local
*.local.md

# --- Workflow Artifacts ---
.claude/workflows/*.registry.json
.claude/workflows/launch-queue.jsonl
